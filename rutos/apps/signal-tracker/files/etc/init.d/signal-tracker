#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG="/usr/sbin/signal-tracker"
CONFIG="signal_tracker"

start_service() {
	local enabled

	config_load "$CONFIG"
	config_get enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	# restart after crashes, indefinitely (threshold 3600 s, 5 s delay, no retry limit)
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}

# Apply settings without restarting, so a configuration save never interrupts a scan.
reload_service() {
	ubus call signal_tracker reload >/dev/null 2>&1 || true
}
