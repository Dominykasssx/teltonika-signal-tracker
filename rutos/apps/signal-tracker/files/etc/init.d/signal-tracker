#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG="/usr/local/usr/sbin/signal-tracker"
[ -x "$PROG" ] || PROG="/usr/sbin/signal-tracker"
CONFIG="signal_tracker"

# The settings are in section 'general'. The package installs no config file, so upgrades
# keep the settings: without the section (first start, or sections per modem from an older
# version) the file gets the default settings.
setup_config() {
	local opt

	[ "$(uci -q get $CONFIG.general)" = "signal_tracker" ] && return 0
	: > /etc/config/$CONFIG
	uci set $CONFIG.general=signal_tracker
	for opt in enabled=1 device=auto modem=0 metric=signal_quality positions=8 settle=15 samples=5; do
		uci set $CONFIG.general.$opt
	done
	uci commit $CONFIG
	chown uhttpd:uhttpd /etc/config/$CONFIG 2>/dev/null
}

# Runs even when disabled (option enabled '0'): the service then leaves the turntable alone,
# and the WebUI can switch it back on.
start_service() {
	setup_config

	procd_open_instance
	procd_set_param command "$PROG"
	# procd keeps the binary's checksum: a start after an upgrade restarts the new one
	procd_set_param file "$PROG"
	procd_set_param respawn 0 10 0
	procd_close_instance
}
