config signal_tracker 'main'
	option enabled '1'
	# Mechanical range used by manual moves and scans (must fit the ESP32 limits)
	option min_angle '0'
	option max_angle '180'
	option coarse_step '10'
	option fine_step '2'
	# Wait after each move before sampling, and gap between samples (milliseconds)
	option settle_ms '4000'
	option samples '5'
	option sample_interval_ms '2000'
	option min_valid_samples '3'
	option move_timeout_ms '5000'
	# Score points (0-100) the best angle must beat the starting angle by; 0 disables
	option min_improvement '0'
	option weight_rsrp '0.5'
	option weight_rsrq '0.2'
	option weight_sinr '0.3'
	option request_timeout_ms '1000'
	# 'auto' finds the ESP32 by USB id; or an explicit path such as /dev/ttyUSB1
	option device 'auto'
	list usb_id '10c4:ea60'
	list usb_id '1a86:7523'
	list usb_id '1a86:55d4'
	list usb_id '0403:6001'
	list usb_id '0403:6015'
	list usb_id '303a:1001'
	# gsmctl modem USB id (e.g. '1-1'); empty uses the default modem
	option modem ''
	# Use the built-in servo and signal simulator instead of hardware (restart to apply)
	option simulate '0'
	option sim_best_angle '120'
